o.BaseObj = "ArmorStrong.CItem"
o.Model = "armour_copper"
o.DisabledInVoosh = false
o.Light1 = "bronze.CLight"
o.Light2 = "bronze2.CLight"
o.Ambient = Color:New(43,49,51,0)
--------------------------
o.ArmorAdd    = 100
o.ArmorType   = ArmorTypes.Weak
o.RescueFactor = 0.33
o.RespawnTime = 20

--============================================================================
function o:OnInitTemplate()
    self.CubeMap = nil
    self.DetailMap = nil
    self.NormalMap = nil
    self.Destroy = nil
    self.Impulse = nil
    self:ReplaceFunction("_Synchronize","Synchronize")
    self:ReplaceFunction("Synchronize","nil")
     if Cfg.SimpleItems then
    	self.Model = "spawn"
    else
    	self.Model = "armour_copper"
    end
end
--============================================================================
function ArmorWeak:OnCreateEntity()
	  if Cfg.SimpleItems then
	    local e = ENTITY.Create(ETypes.Billboard,"Script","ArmorWeak")    
	    local tex = "../PKPLUSDATA/Textures/Simpleitems/ArmorWeak.tga"        
	    BILLBOARD.SetupCorona(e,1,0,0,0,0,0.5,0,0,0,tex,Color:New(255,255,255,0):Compose(),1,true)    
	    ENTITY.SetPosition(e,0,0,0)
	    ENTITY.RegisterChild(self._Entity,e,true,0) 
	    WORLD.AddEntity(e)
    end
    ENTITY.SetSynchroString(self._Entity,"ArmorWeak.CItem") 
    ENTITY.EnableNetworkSynchronization(self._Entity,true,true)
    self._orient = FRand(7.26)
    self:Client_OnCreateEntity(self._Entity)		
end
